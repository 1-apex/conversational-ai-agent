    uuid id PK
    uuid call_id FK
    uuid reviewer_id FK
    text failure_class
    text notes
    text status
  }
  evaluation_datasets {
    uuid id PK
    text version UK
    text content_hash
  }
  evaluation_cases {
    text id PK
    uuid dataset_id FK
    text category
    text severity
    jsonb definition
    uuid source_review_id FK
  }
  evaluation_runs {
    uuid id PK
    uuid dataset_id FK
    text model_id
    text prompt_version
    text policy_version
    text knowledge_version
    jsonb aggregates
    text gate_result
  }
  evaluation_results {
    uuid id PK
    uuid run_id FK
    text case_id FK
    boolean passed
    jsonb scores
    jsonb response_snapshot
  }
  audit_logs {
    bigint id PK
    uuid actor_id FK
    text action
    text target_type
    text target_id
    text correlation_id
    text prev_hash
    text entry_hash
    timestamptz created_at
  }
