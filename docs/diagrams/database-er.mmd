  organizations {
    uuid id PK
    text name
  }
  users {
    uuid id PK
    uuid organization_id FK
    text email UK
    text password_hash
    text status
  }
  user_roles {
    uuid user_id PK, FK
    text role PK
  }
  sessions {
    uuid id PK
    uuid user_id FK
    text token_hash UK
    timestamptz expires_at
    timestamptz revoked_at
  }
  audit_logs {
    bigint id PK
    uuid actor_id
    text action
    text target_type
    text target_id
    jsonb metadata
    text prev_hash
    text entry_hash
  }
  calls {
    uuid id PK
    uuid organization_id FK
    text state
    text active_agent
    boolean emergency_locked
    text sentiment
    timestamptz ended_at
    timestamptz retention_expires_at
  }
  call_turns {
    uuid id PK
    uuid call_id FK
    int sequence
    text speaker
    text text_content
    text pathway
    text validation_status
    text prompt_version
    text policy_version
    text model_id
    jsonb timings
  }
  call_summaries {
    uuid call_id PK, FK
    jsonb intelligence
    text method
    boolean human_corrected
  }
  safety_events {
    uuid id PK
    uuid call_id FK
    text stage
    text severity
    text_array rule_ids
    text action_taken
    text policy_version
  }
  escalations {
    uuid id PK
    uuid call_id FK
    uuid assigned_to FK
    text reason
    text priority
    text status
    text encrypted_contact
  }
  escalation_events {
    uuid id PK
    uuid escalation_id FK
    uuid actor_id FK
    text event_type
  }
  follow_up_tasks {
    uuid id PK
    uuid call_id FK
    uuid owner_id FK
    text description
    text status
  }
  knowledge_documents {
    uuid id PK
    uuid organization_id FK
    text title
    text source_type
    text audience
  }
  knowledge_versions {
    uuid id PK
    uuid document_id FK
    int version
    text status
    text_array flags
    date effective_date
    date expiry_date
    uuid uploaded_by FK
    uuid approved_by FK
  }
  knowledge_chunks {
    uuid id PK
    uuid version_id FK
    text section
    text source_location
    text content
    vector embedding
    tsvector search_vector
  }
  turn_citations {
    uuid turn_id PK
    uuid chunk_id PK, FK
    uuid version_id FK
  }
  review_items {
    uuid id PK
    uuid call_id FK
    uuid reviewer_id FK
    text failure_class
    jsonb proposed_case
  }
  evaluation_runs {
    uuid id PK
    text tier
    text dataset_version
    text prompt_version
    text policy_version
    text model_id
    jsonb aggregates
    text gate_result
  }
  evaluation_results {
    uuid id PK
    uuid run_id FK
    text case_id
    boolean passed
    text_array failures
  }
