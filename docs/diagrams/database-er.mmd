  sessions {
    uuid id PK
    uuid user_id FK
    timestamptz expires_at
    timestamptz revoked_at
  }
  follow_up_tasks {
    uuid id PK
    uuid call_id FK
    uuid owner_id FK
    text description
    text status
    date due_date
  }
  organizations {
    uuid id PK
    text name
    timestamptz created_at
  }
  users {
    uuid id PK
    uuid organization_id FK
    text email UK
    text status
  }
  roles {
    text name PK
  }
  user_roles {
    uuid user_id PK, FK
    text role_name PK, FK
  }
  calls {
    uuid id PK
    uuid organization_id FK
    text state
    text active_agent
    text data_mode
    timestamptz started_at
    timestamptz ended_at
    timestamptz retention_expires_at
  }
  call_turns {
    uuid id PK
    uuid call_id FK
    int sequence
    text speaker
    text agent
    text text_content
    text validation_status
    uuid prompt_version_id FK
    text model_id
  }
  call_summaries {
    uuid call_id PK, FK
    jsonb intelligence
    text method
    text model_id
    boolean human_corrected
  }
  safety_events {
    uuid id PK
    uuid call_id FK
    uuid turn_id FK
    uuid policy_id FK
    text category
    text severity
    text action_taken
    text detector
  }
  safety_policies {
    uuid id PK
    text version UK
    jsonb rules
    text approved_by
    text status
  }
  prompt_versions {
    uuid id PK
    text agent
    text version
    text content_hash
    text status
  }
  escalations {
    uuid id PK
    uuid call_id FK
    uuid assigned_to FK
    text reason
    text priority
    text status
    text encrypted_contact
  }
  escalation_events {
    uuid id PK
    uuid escalation_id FK
    uuid actor_id FK
    text event_type
    timestamptz created_at
  }
  knowledge_documents {
    uuid id PK
    uuid organization_id FK
    text title
    text source_type
    text product
  }
  knowledge_versions {
    uuid id PK
    uuid document_id FK
    text version
    text status
    date effective_date
    text content_hash
    uuid uploaded_by FK
    uuid approved_by FK
  }
  knowledge_chunks {
    uuid id PK
    uuid version_id FK
    text section
    text source_location
    text content
    vector embedding
    tsvector search_vector
    text content_hash
  }
  turn_citations {
    uuid turn_id PK, FK
    uuid chunk_id PK, FK
    uuid version_id FK
  }
