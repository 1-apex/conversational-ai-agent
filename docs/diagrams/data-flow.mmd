%% STATUS: IMPLEMENTED for synthetic data. Personal data is redacted before the model (2026-11-05, branch platform-phases).
flowchart LR
  caller["Caller voice, PHI may enter here"]
  subgraph browser["Browser"]
    micb["Microphone audio"]
    transcript["Transcript text, PHI possible"]
  end
  subgraph server["Application boundary"]
    minim["PII and PHI detection, minimisation"]
    pipe["Turn pipeline"]
    logs["Redacted logs and traces"]
    post["Post-call extraction"]
  end
  subgraph store["Neon Postgres"]
    calls[("calls and call_turns, PHI possible")]
    contacts[("restricted contact data, PHI")]
    sum[("call_summaries, PHI possible")]
    events[("safety_events, redacted")]
    audit[("audit_logs, IDs only")]
    know[("knowledge, no PHI")]
  end
  stt["STT provider, PHI leaves here"]
  llm["LLM providers, PHI leaves here unless minimised"]
  tts["TTS provider, reply text"]
  obs["Observability, must receive no PHI"]
  rediss["Redis, hashed keys only"]
  ret["Retention job"]
  del["Deletion request"]
  caller --> micb --> stt --> transcript --> minim --> pipe
  pipe --> llm
  pipe --> tts
  pipe --> calls
  pipe --> contacts
  pipe --> events
  know --> pipe
  calls --> post --> llm
  post --> sum
  pipe -.-> logs --> obs
  pipe -.-> rediss
  pipe --> audit
  ret -->|expire| calls
  ret -->|expire| sum
  ret -->|expire| contacts
  del --> calls
  del --> sum
  del --> contacts
  del -->|record the deletion| audit
