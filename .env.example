# Everything here is optional. With nothing set, the call screen works in a limited way
# and staff pages explain that they need a database. See docs/testing-guide.md.

# ── Agent replies ─────────────────────────────────────────────────────────────
# Groq — console.groq.com → API Keys
GROQ_API_KEY=

# ── Voice ─────────────────────────────────────────────────────────────────────
# ElevenLabs — elevenlabs.io → Profile → API Key
# Without this the app falls back to a voice on the device.
ELEVENLABS_API_KEY=

# ── Call briefs ───────────────────────────────────────────────────────────────
# Anthropic — console.anthropic.com. Without this, briefs use Groq, then regex rules.
ANTHROPIC_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Local, no account needed: pglite://.data/dev
# Neon: postgres://user:password@host/dbname?sslmode=require
# Without this, calls aren't logged and staff pages are unavailable.
# Never set this on a public deployment you haven't locked down: see docs/14.
DATABASE_URL=

# Test password for the accounts created by npm run db:seed. Local use only, 10+ characters.
SEED_PASSWORD=

# ── Secrets ───────────────────────────────────────────────────────────────────
# Signs call tokens and derives the key that encrypts callback numbers. Use a long random
# value, and don't change it casually: existing tokens and stored numbers stop working.
# Falls back to a value derived from GROQ_API_KEY.
CALL_TOKEN_SECRET=

# Required by the daily retention job (Vercel Cron sends it automatically).
CRON_SECRET=

# ── Knowledge ─────────────────────────────────────────────────────────────────
# legacy (default): the unverified text in lib/inogen-knowledge.ts
# retrieval: only documents a second person approved. Needs DATABASE_URL.
KNOWLEDGE_MODE=legacy

# Optional, for vector search. Any OpenAI-compatible embeddings endpoint.
# Without these, retrieval uses keyword search only.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Days before call records are deleted. Provisional, see docs/19-data-governance.md.
RETENTION_DAYS=30

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Upstash Redis — upstash.com. Without this, each server instance keeps its own limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
