# ── Phase 2: AI Provider ─────────────────────────────────────────────────────
# Anthropic Claude — get key from console.anthropic.com
ANTHROPIC_API_KEY=

# ── Phase 3: Database ─────────────────────────────────────────────────────────
# PostgreSQL (Neon / Supabase / local). For SQLite use: file:./dev.db
DATABASE_URL=

# ── Phase 4: Email Notifications ─────────────────────────────────────────────
# Resend — get key from resend.com
RESEND_API_KEY=
EMAIL_FROM=appointments@carelink.ai

# ── Phase 4: SMS & Voice Calls ───────────────────────────────────────────────
# Twilio — get from console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Phase 6: Rate Limiting ───────────────────────────────────────────────────
# Upstash Redis — get from upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
