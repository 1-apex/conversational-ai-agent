# ── Active agents: LLM ───────────────────────────────────────────────────────
# Groq (free) — console.groq.com → API Keys
GROQ_API_KEY=

# ── Active agents: TTS voice ──────────────────────────────────────────────────
# ElevenLabs neural TTS — elevenlabs.io → Profile → API Key
# Free tier: 10,000 characters/month. Without this key the app falls back to
# the browser's built-in Web Speech Synthesis (robotic but functional).
ELEVENLABS_API_KEY=

# ── Call briefs (optional) ────────────────────────────────────────────────────
# Anthropic Claude — get key from console.anthropic.com
# Without this, briefs use Groq, then regex rules.
ANTHROPIC_API_KEY=

# ── Database (Neon) ───────────────────────────────────────────────────────────
# Neon serverless Postgres — neon.tech → Project → Connection string
# Format: postgres://user:password@host/dbname?sslmode=require
# Without this, call logging is silently skipped (app still works normally).
DATABASE_URL=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Upstash Redis — get from upstash.com
# Without this, each server instance keeps its own in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
